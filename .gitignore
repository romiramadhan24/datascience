# ==============================================================================
# 🔐 SECRETS & CREDENTIALS (Sangat Penting untuk GitHub Push Protection)
# ==============================================================================
*.json
.env

# ==============================================================================
# 🔴 JULIA SYSTEM & GENERATED FILES
# ==============================================================================
# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by BinaryProvider & BinDeps
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Documentation build output
docs/build/
docs/site/
data/

# Local preferences
LocalPreferences.toml
JuliaLocalPreferences.toml

# Manifest.toml (Gunakan jika ingin environment bersifat dinamis di tim/pindah mesin)
Manifest*.toml

# ==============================================================================
# 🐍 PYTHON & CONDAPKG / PIXI ENVIRONMENT
# ==============================================================================
.CondaPkg/
.pixi/
__pycache__/
*.pyc
.pixi/*
!.pixi/config.toml

# ==============================================================================
# 📊 DATASETS & TEMPORARY DATA FILES
# ==============================================================================
*.csv
*.arrow
*.parquet
*.feather
*.xlsx